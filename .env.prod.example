# Copy to .env.prod, fill in, then:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# This brings up api/postgres/redis locally. The frontend (`web`) stays on
# Vercel - see the README's "Locally-hosted API + Vercel frontend" section
# for the Vercel-side setup (SERVER_URL pointing at the Funnel URL below).

# Postgres password (used by both the postgres and api services). This gets
# embedded directly into DATABASE_URL as postgresql://postgres:<this>@postgres:5432/ecommerce
# with no URL-encoding, so avoid characters that are unsafe in a URL userinfo
# section (/, +, @, :, %, etc.) - e.g. generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Tailscale auth key for the ts-api sidecar. Generate a reusable, tagged key at
# https://login.tailscale.com/admin/settings/keys (ephemeral keys will drop the
# node on every restart - use a non-ephemeral reusable key instead). Also
# enable Funnel for this node/tag at
# https://login.tailscale.com/admin/settings/funnel if it isn't already.
TS_AUTHKEY=

# Tailnet hostname - the api will be publicly reachable at
# https://<this>.<your-tailnet>.ts.net via Tailscale Funnel (Vercel Hobby
# can't join the tailnet directly, so this has to be public HTTPS, not
# tailnet-private).
TS_HOSTNAME=gpu-store-api

# Your Vercel deployment's origin (used for CORS_ORIGIN / FRONTEND_URL on the
# api), e.g. https://gpu-store.vercel.app or your custom domain.
WEB_ORIGIN=https://gpu-store-web-b1y2.vercel.app/
