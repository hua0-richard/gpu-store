# Copy to .env.prod.api and fill in. Loaded by the api service in
# docker-compose.prod.yml (env_file). Secrets only - everything else
# (PORT, DATABASE_URL, REDIS_*, CORS_ORIGIN, FRONTEND_URL) is wired up
# in docker-compose.prod.yml itself.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Signs/verifies session + refresh JWTs (apps/api/src/auth/constants.ts).
# Required here - the API is publicly reachable via Funnel, so the '1234'
# code fallback must not be used. Generate with: openssl rand -base64 48
JWT_SECRET=
